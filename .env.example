# =============================================================================
# Sable — mẫu biến môi trường (.env.example)
# Sao chép:  cp .env.example .env.local && chmod 600 .env.local
# Điền giá trị thật vào .env.local (đã gitignore). KHÔNG commit secret.
# Kill switch: hầu hết module bật khi biến vắng; đặt =0 để tắt.
# Vault (ưu tiên hơn env khi code phân biệt): Settings → Vault hoặc API /api/vault
#   sau khi có SABLE_VAULT_KEY — tên vault: BRIDGE_*, GOOGLE_OAUTH_*, SABLE_IMAGE_API_KEY,
#   OAUTH_TOKEN_* (app tự ghi, không đặt tay trong .env).
# Tài liệu: docs/vi/08-cau-hinh-env.md
# =============================================================================

# --- Tối thiểu để boot có chat ---
# Ít nhất MỘT khóa LLM (XAI / OPENAI / DEEPSEEK / LLM_*). Không có → UI lên, chat/media 503.
XAI_API_KEY=
# SABLE_PASSWORD=                      # Basic auth user "sable" khi expose public (ngrok/proxy). Bắt buộc nếu public.
# SABLE_TRUSTED_ORIGINS=https://sable.example.com   # Origin https công khai (CSRF/OAuth). Bắt buộc nếu public.
# SABLE_PORT=8080                      # Cổng listen. Mặc định 8080. Tùy chọn.
# SABLE_DATA_DIR=/var/lib/sable        # Thư mục dữ liệu 0700. Mặc định /workspace/sable-data. Nên đặt trên VPS.
# SABLE_VAULT_KEY=                     # openssl rand -base64 32 — bắt buộc nếu dùng vault/OAuth/bridge trong vault.

# =============================================================================
# Provider LLM
# =============================================================================
# XAI_API_KEY=                         # Khóa xAI. Bí mật. Bắt buộc* (*một trong các khóa LLM).
# XAI_BASE_URL=https://api.x.ai        # Base API xAI. Mặc định https://api.x.ai. Tùy chọn.
# XAI_MODELS=                          # Danh sách model csv. Mặc định grok-4.7,grok-4.6,grok-4.5. Tùy chọn.
# XAI_API_STYLE=                       # Style API (responses/chat). Tự suy từ base nếu trống. Tùy chọn.
# GROK_PROXY_TOKEN=                    # Token proxy CLI (thay XAI_API_KEY trên một số host). Bí mật. Tùy chọn.
# OPENAI_API_KEY=                      # Khóa OpenAI / tương thích. Bí mật. Tùy chọn (hoặc embeddings).
# OPENAI_BASE_URL=https://api.openai.com  # Mặc định https://api.openai.com. Tùy chọn.
# OPENAI_MODELS=                       # Mặc định gpt-4.1,gpt-4.1-mini,gpt-4o nếu trống. Tùy chọn.
# OPENAI_API_STYLE=                    # Tùy chọn.
# DEEPSEEK_API_KEY=                    # Khóa DeepSeek. Bí mật. Tùy chọn.
# DEEPSEEK_BASE_URL=https://api.deepseek.com  # Mặc định https://api.deepseek.com. Tùy chọn.
# DEEPSEEK_MODELS=                     # Mặc định deepseek-chat,deepseek-reasoner. Tùy chọn.
# DEEPSEEK_API_STYLE=                  # Tùy chọn.
# LLM_API_KEY=                         # Provider generic OpenAI-compatible (ưu tiên đầu). Bí mật. Tùy chọn.
# LLM_BASE_URL=                        # Base URL generic (fallback XAI_BASE_URL / api.x.ai). Tùy chọn.
# LLM_MODELS=                          # Nếu đặt = toàn bộ list model UI. Tùy chọn.
# LLM_API_STYLE=                       # Tùy chọn.
# LLM_MAX_TOKENS=8192                  # Trần token output chat. Mặc định 8192 (cap nội bộ). Tùy chọn.
# OLLAMA_BASE_URL=http://127.0.0.1:11434  # Ollama. Mặc định :11434 khi có OLLAMA_MODELS. Tùy chọn.
# OLLAMA_MODELS=                       # Ví dụ llama3.2:1b. Tùy chọn.
# OLLAMA_API_KEY=ollama                # Mặc định "ollama". Tùy chọn.
# OLLAMA_API_STYLE=chat                # Mặc định chat. Tùy chọn.
# SABLE_OLLAMA=1                       # Kill: =0 tắt Ollama. Mặc định bật. Tùy chọn.
# LOCAL_BASE_URL=                      # LM Studio / vLLM / llama.cpp. Tùy chọn.
# LOCAL_MODELS=                        # Bắt buộc nếu dùng LOCAL_*. Tùy chọn.
# LOCAL_API_KEY=local                  # Mặc định "local". Tùy chọn.
# LOCAL_API_STYLE=chat                 # Mặc định chat. Tùy chọn.

# =============================================================================
# Model router / bước chat
# =============================================================================
# SABLE_MODEL_DEFAULT=grok-4.7         # Model mặc định UI. Mặc định grok-4.7. Tùy chọn.
# SABLE_MODEL_HARD=grok-4.7            # Bậc nặng (budget router). Mặc định grok-4.7. Tùy chọn.
# SABLE_MODEL_LIGHT=                   # Bậc nhẹ (triage/self-eval/planner). Trống → dùng hard. Khuyến nghị đặt.
# SABLE_MODEL_CHEAP=                   # Alias light nếu LIGHT trống. Tùy chọn.
# SABLE_MODEL_ROUTER=1                 # =0 luôn hard. Mặc định 1. Tùy chọn.
# SABLE_MAX_STEPS=6                    # Max bước tool/chat (1–10). Mặc định 6. Tùy chọn.
# SABLE_RESPONSES_STATELESS=           # =1 replay items thay previous_response_id. Mặc định tắt. Tùy chọn.
# SABLE_OWNER_NAME=                    # Tên chủ trong brief. Mặc định "the owner". Tùy chọn.

# =============================================================================
# Auth / public / CSRF / rate (harden Vite)
# =============================================================================
# SABLE_PASSWORD=                      # HTTP basic user sable. Bí mật. Bắt buộc khi public có basic.
# SABLE_PUBLIC=1                       # Tắt HMR websocket (tunnel). Headless mặc định set 1. Tùy chọn.
# SABLE_HMR=                           # Ép bật/tắt HMR; nếu trống theo !SABLE_PUBLIC. Tùy chọn.
# SABLE_TRUSTED_ORIGINS=               # CSV https origins. Mặc định "". Bắt buộc public/OAuth.
# SABLE_CSRF=1                         # =0 tắt CSRF. Mặc định 1. Tùy chọn.
# SABLE_RATE=1                         # =0 tắt rate limit. Mặc định 1. Tùy chọn.
# SABLE_RATE_READ=600                  # Req/phút/IP. Mặc định 600. Tùy chọn.
# SABLE_RATE_WRITE=120                 # Ghi/phút/IP. Mặc định 120. Tùy chọn.
# SABLE_RATE_SHARE=60                  # /s/ phút/IP. Mặc định 60. Tùy chọn.
# SABLE_MAX_BODY=10000000              # Content-Length max bytes. Mặc định 10_000_000. Tùy chọn.
# VITE_AUTH_ENABLED=                   # "false" tắt Better Auth (default shipped). Platform có thể set true.
# BETTER_AUTH_URL=                     # Base URL Better Auth khi deploy. Platform. Tùy chọn.
# BETTER_AUTH_SECRET=                  # Secret Better Auth. Bí mật. Platform / tùy chọn.
# DATABASE_URL=                        # Postgres/Neon. Trống → PGLite. Tùy chọn.
# GROK_AUTH_ISSUER=                    # Issuer OAuth Grok broker. Platform. Tùy chọn.
# GROK_AUTH_CLIENT_ID=                 # Client id broker. Platform. Tùy chọn.
# GROK_AUTH_CLIENT_SECRET=             # Client secret broker. Bí mật. Platform. Tùy chọn.
# VITE_PUBLIC_HOSTNAME=                # Hostname public build. Tùy chọn.
# VITE_STUN_URLS=                      # STUN P2P (nếu dùng). Tùy chọn.
# VITE_GROK_EXTENSIONS=                # Flag build Grok. Tùy chọn.
# GROK_PROJECT_ID=                     # Platform Grok. Tùy chọn.
# GROK_GATE_ORIGIN=                    # Platform. Tùy chọn.
# GROK_CONNECTORS_URL=                 # Platform connectors. Tùy chọn.
# GROK_CONNECTOR_ACCESS_TOKEN=         # Platform. Bí mật. Tùy chọn.

# =============================================================================
# Đường dẫn / process
# =============================================================================
# SABLE_DATA_DIR=/workspace/sable-data # Jobs, memory, vault, desk… mode 0700. Nên đặt bền trên VPS.
# SABLE_WORKSPACE=/workspace/sable-workspace  # Jail fs/shell/browser/code. Mặc định /workspace/sable-workspace.
# SABLE_TASK_WORKSPACE_ROOT=           # Gốc workspace từng task (W1). Mặc định dưới workspace/tasks. Tùy chọn.
# SABLE_SKILLS_DIR=                    # Thư mục skills. Mặc định ./skills. Tùy chọn.
# SABLE_CHROME_PATH=                   # Binary Chrome/Chromium. Tự tìm nếu trống. Tùy chọn.
# SABLE_NOVNC_DIR=/usr/share/novnc     # noVNC static. Mặc định /usr/share/novnc. Tùy chọn.
# SABLE_HEADLESS_CMD=npm               # Lệnh watchdog headless. Mặc định npm. Tùy chọn.
# SABLE_HEADLESS_ARGS=run dev          # Args. Mặc định "run dev". Tùy chọn.
# SABLE_HEADLESS_PING=                 # Health URL. Mặc định http://127.0.0.1:$PORT/api/jobs. Tùy chọn.
# SABLE_EVAL_URL=http://127.0.0.1:8080 # Base URL eval scripts. Tùy chọn.
# SABLE_EVAL_LIVE_MODEL=               # =1 bật check model thật trong eval:w7. Tùy chọn.
# SABLE_EVAL_NIGHTLY=                  # Đánh dấu env con nightly (app set). Không cần đặt tay.
# MCP_SERVERS=                         # JSON MCP servers (allowLocal chỉ hợp lệ ở đây). Tùy chọn.
# SABLE_FETCH_ALLOW=                   # Allowlist host thêm cho fetch/SSRF. Tùy chọn.
# SABLE_FETCH_FAKE_IP=                 # =1 egress fake-IP (test). Mặc định tắt. Tùy chọn.

# =============================================================================
# Vault
# =============================================================================
# SABLE_VAULT=1                        # =0 tắt vault. Mặc định 1.
# SABLE_VAULT_KEY=                     # Passphrase hoặc 32-byte base64. Bí mật. Bắt buộc để lưu vault.
# Vault names (không đặt trong .env; dùng UI Vault): BRIDGE_PEER_URL, BRIDGE_SECRET (≥32),
#   BRIDGE_PEER_TOKEN, GOOGLE_OAUTH_CLIENT_ID, GOOGLE_OAUTH_CLIENT_SECRET, SABLE_IMAGE_API_KEY.
#   OAUTH_TOKEN_* do app ghi sau Connect — /api/vault không trả giá trị các tên này.

# =============================================================================
# Kill switches lõi (mặc định bật khi unset; =0 tắt)
# =============================================================================
# SABLE_JOBS=1                         # Job nền.
# SABLE_ROUTINES=1                     # Routine (cần JOBS).
# SABLE_TRIGGERS=1                     # Webhook fire + watch (cần ROUTINES+JOBS).
# SABLE_CHANNELS=1                     # Telegram + SMTP + webhook adapter.
# SABLE_TOOLS=1                        # Tool agent.
# SABLE_MEMORY=1                       # Learned memory.
# SABLE_SHELL=1                        # shell_run bwrap.
# SABLE_BROWSER=1                      # Playwright browser tool.
# SABLE_VOICE=1                        # STT/TTS.
# SABLE_PROFILES=1                     # Multi-agent profiles.
# SABLE_SPAWN=1                        # spawn_agent.
# SABLE_SKILLS=1                       # Skill runtime.
# SABLE_MCP=1                          # MCP client.
# SABLE_WEBHOOK=1                      # Kênh webhook (cần SECRET).
# SABLE_DESK_SYNC=1                    # Đồng bộ desk server.
# SABLE_CATCHUP=1                      # Catch-up routine sau suspend (alias SABLE_ROUTINE_CATCHUP).
# SABLE_ROUTINE_CATCHUP=1              # Giống CATCHUP.
# SABLE_VAULT=1
# SABLE_ROUTER=1                       # Router skill 3 trục.
# SABLE_SCOPE=1                        # =0 fail-closed deny ACT cần scope.
# SABLE_TOOLINDEX=1                    # Đề xuất cài tool PATH.
# SABLE_PLANNER=1
# SABLE_WORKSPACES=1                   # Per-task workspace.
# SABLE_BUDGET=1                       # =0 chỉ meter, không fail-closed cap.
# SABLE_TRACE=1
# SABLE_MEDIA=1
# SABLE_MEDIA_TOOL=1                   # Tool gen ảnh trong chat.
# SABLE_VIDEO=1                        # Kill video gen.
# SABLE_CANVAS=1
# SABLE_SHARE=1                        # Canvas share links.
# SABLE_PROACTIVE=1                    # Lớp proactive (triage/brief cần thêm).
# SABLE_TRIAGE=1
# SABLE_BRIEF=1                        # Morning brief (routine vẫn default off trong settings).
# SABLE_OAUTH=1                        # Gmail/Calendar connectors.
# SABLE_DESKTOP=1                      # Computer-use :99.
# SABLE_RESEARCH=1
# SABLE_CODEAGENT=1
# SABLE_VECTOR=1
# SABLE_RECALL_CONTEXT=1               # =0 không inject recall block.
# SABLE_SELFEVAL=1
# SABLE_BRIDGE=0                       # Khuyến nghị 0 đến khi cấu hình peer; unset+đủ URL/secret = on.
# SABLE_CHAT_QUEUE=1                   # =0 composer/API turns kiểu cũ.

# =============================================================================
# Jobs / routines / spawn
# =============================================================================
# SABLE_JOB_CONCURRENCY=2              # Job song song. Mặc định 2 (1–8).
# SABLE_JOB_MAX_STEPS=20               # Mặc định 20.
# SABLE_JOB_TIMEOUT_MIN=20             # Mặc định 20 phút.
# SABLE_JOB_APPROVAL_TTL_MIN=          # Nếu set (phút) ghi đè TTL giờ.
# SABLE_JOB_APPROVAL_TTL_H=24          # TTL duyệt. Mặc định 24 giờ.
# SABLE_JOB_RECOVERY=requeue           # requeue|fail khi restart. Mặc định requeue.
# SABLE_ROUTINE_TICK_SEC=30            # Tick scheduler. Mặc định 30s.
# SABLE_ROUTINE_CATCHUP_HOURS=24       # Cửa sổ catch-up. Mặc định 24h.
# SABLE_WATCH_TICK_S=60                # Tick watch URL/RSS. Mặc định 60s.
# SABLE_SPAWN_MAX_CHILDREN=3           # Mặc định 3.
# SABLE_SPAWN_MAX_STEPS=6              # Mặc định 6.
# SABLE_SPAWN_TIMEOUT_S=180            # Mặc định 180s.
# SABLE_HEAVY_MAX=2                    # Desktop/research/code/spawn nặng. Mặc định 2 (max 2).
# SABLE_BUDGET_MAX_TOKENS=             # Trần token global (số). Trống = không trần số.
# SABLE_BUDGET_MAX_USD=                # Trần USD global. Trống = không trần.

# =============================================================================
# Memory
# =============================================================================
# SABLE_MEMORY_MAX=500                 # Cap item. Mặc định 500.
# SABLE_MEMORY_JOURNAL_DAYS=365        # Giữ journal. Mặc định 365.
# SABLE_MEMORY_MODEL=                  # Model trích memory (rẻ hơn). Mặc định = chat model.

# =============================================================================
# Telegram
# =============================================================================
# SABLE_TELEGRAM_TOKEN=                # Token BotFather. Bí mật. Bắt buộc để bật TG.
# SABLE_TELEGRAM_OWNER_IDS=            # Numeric user id csv. Bắt buộc kèm token.
# SABLE_TELEGRAM_MODEL=                # Model job TG. Mặc định model đầu available.
# SABLE_TELEGRAM_TOOLS=files,fetch     # Mặc định files,fetch (thêm web,x…).
# SABLE_TELEGRAM_NOTIFY=own            # own|all|off. Mặc định own.
# SABLE_TELEGRAM_RATE=20               # Max job/10 phút. Mặc định 20.
# SABLE_TELEGRAM_POLL_SEC=25           # Long-poll. Mặc định 25.
# SABLE_TELEGRAM_API_BASE=             # Chỉ mock test. Mặc định api.telegram.org.
# SABLE_CHANNEL_ACK_MS=5000            # Trễ "Đã nhận ✓" (W7). Mặc định 5000.

# =============================================================================
# SMTP notify (không duyệt qua mail)
# =============================================================================
# SABLE_SMTP_HOST=                     # Ví dụ smtp.gmail.com. Bắt buộc nếu dùng mail.
# SABLE_SMTP_PORT=587                  # Mặc định 587.
# SABLE_SMTP_SECURE=                   # =1 implicit TLS; mặc định 1 khi port 465 else 0.
# SABLE_SMTP_USER=                     # Tùy chọn.
# SABLE_SMTP_PASS=                     # App password. Bí mật.
# SABLE_SMTP_FROM=                     # Mặc định = USER.
# SABLE_SMTP_TO=                       # Đúng một địa chỉ nhận. Bắt buộc nếu SMTP.
# SABLE_SMTP_NOTIFY=own                # own|all|off. Mặc định own.
# SABLE_SMTP_ALLOW_INSECURE=           # =1 cho phép SMTP plaintext (lab). Mặc định tắt.

# =============================================================================
# Webhook channel (HMAC)
# =============================================================================
# SABLE_WEBHOOK_SECRET=                # ≥16 ký tự. Bí mật. Bắt buộc để bật.
# SABLE_WEBHOOK_URL=                   # Outbound https (SSRF). Tùy chọn.
# SABLE_WEBHOOK_OWNER=owner            # peerId được phép. Mặc định owner.
# SABLE_WEBHOOK_NOTIFY=own             # own|all|off. Mặc định own (code notifyMode).
# SABLE_WEBHOOK_RATE=30                # Max message.in /10 phút. Mặc định 30.

# =============================================================================
# OAuth Google (W2b) — client ưu tiên vault GOOGLE_OAUTH_*; env fallback dưới đây
# =============================================================================
# SABLE_GOOGLE_CLIENT_ID=              # Hoặc vault GOOGLE_OAUTH_CLIENT_ID.
# SABLE_GOOGLE_CLIENT_SECRET=          # Bí mật. Hoặc vault GOOGLE_OAUTH_CLIENT_SECRET.
# SABLE_OAUTH_REDIRECT_BASE=           # Origin redirect; mặc định origin đầu TRUSTED_ORIGINS.
# Redirect đăng ký Google: {base}/api/oauth/callback

# =============================================================================
# Bridge sable.bridge.v1 — vault BRIDGE_* ưu tiên; env fallback
# =============================================================================
# SABLE_BRIDGE=                        # =0 tắt; bật khi có URL+secret (≥32) trừ khi =0.
# SABLE_BRIDGE_URL=                    # https peer. Hoặc vault BRIDGE_PEER_URL.
# SABLE_BRIDGE_SECRET=                 # ≥32 ký tự. Bí mật. Hoặc vault BRIDGE_SECRET.
# SABLE_BRIDGE_PEER_TOKEN=             # Bearer tùy chọn. Bí mật. Hoặc vault BRIDGE_PEER_TOKEN.
# SABLE_BRIDGE_RATE=30                 # Accepted/phút. Mặc định 30.

# =============================================================================
# Chat queue / turns (W7)
# =============================================================================
# SABLE_CHAT_QUEUE=1                   # =0 đường /api/chat cũ.
# SABLE_CHAT_CONCURRENCY=3             # Cap lượt (1–8). Mặc định 3; trừ heavy ≥1.

# =============================================================================
# Desktop :99
# =============================================================================
# SABLE_DESKTOP=1
# SABLE_DESKTOP_IDLE_MIN=10            # Auto-stop. Mặc định 10.
# SABLE_DESKTOP_MAX_STEPS=15           # Mặc định 15.
# SABLE_DESKTOP_MODEL=grok-4.7         # Mặc định grok-4.7.
# SABLE_DESKTOP_RUN_USD=0.5            # Cap USD/run. Mặc định 0.5.
# SABLE_DESKTOP_VNC_PORT=5999          # Mặc định 5999.
# SABLE_DESKTOP_WS_PORT=6099           # Mặc định 6099.
# SABLE_DESKTOP_WM=                    # =none bỏ window manager.

# =============================================================================
# Research / code
# =============================================================================
# SABLE_RESEARCH=1
# SABLE_RESEARCH_RUN_USD=0.5           # Mặc định 0.5.
# SABLE_RESEARCH_MAX_STEPS=40          # Mặc định 40.
# SABLE_RESEARCH_MAX_SOURCES=8         # Mặc định 8.
# SABLE_RESEARCH_MAX_QUERIES=3         # Mặc định 3.
# SABLE_RESEARCH_CONCURRENCY=3         # Mặc định 3.
# SABLE_RESEARCH_MODEL=grok-4.5        # Mặc định grok-4.5.
# SABLE_RESEARCH_SEARCH_MODEL=grok-4.5  # web_search model. Mặc định grok-4.5.
# SABLE_CODEAGENT=1
# SABLE_CODE_REPOS=/workspace          # CSV root được phép. Mặc định /workspace.
# SABLE_CODE_RUN_USD=0.5               # Mặc định 0.5.
# SABLE_CODE_MAX_STEPS=20              # Mặc định 20.
# SABLE_CODE_CMD_TIMEOUT_S=60          # Mặc định 60.
# SABLE_CODE_MODEL=grok-4.5            # Mặc định grok-4.5.

# =============================================================================
# Media / voice
# =============================================================================
# SABLE_MEDIA=1
# SABLE_IMAGE_MODEL_XAI=grok-imagine-image-2.0  # Mặc định grok-imagine-image-2.0.
# SABLE_IMAGE_BASE_URL=                # OpenAI-compatible image API. Tùy chọn.
# SABLE_IMAGE_API_KEY=                 # Env hoặc vault cùng tên. Bí mật.
# SABLE_IMAGE_MODEL=gpt-image-1        # Mặc định gpt-image-1.
# SABLE_IMAGE_ALLOW_LOCAL=             # =1 cho phép http loopback base. Mặc định tắt.
# SABLE_VIDEO_MODEL_XAI=grok-imagine-video-1.5  # Mặc định grok-imagine-video-1.5.
# SABLE_MEDIA_IMAGE_USD=0.07           # Ước phí ảnh nếu set; mặc định code 0.07.
# SABLE_MEDIA_VIDEO_USD=0.5            # Mặc định code 0.5.
# SABLE_MEDIA_MAX_USD=                 # Trần media; trống = không trần số.
# VOICE_API_KEY=                       # STT/TTS; fallback OPENAI_API_KEY. Bí mật.
# VOICE_BASE_URL=                      # OpenAI-compatible audio base. Tùy chọn.
# VOICE_STT_MODEL=whisper-1            # Mặc định whisper-1.
# VOICE_TTS_MODEL=tts-1                # Mặc định tts-1.
# VOICE_TTS_VOICE=alloy                # Mặc định alloy.

# =============================================================================
# Vector / recall / trace / toolindex
# =============================================================================
# SABLE_VECTOR=1
# SABLE_EMBED_PROVIDER=auto            # auto|openai|xai|local|hash. Mặc định auto.
# SABLE_EMBED_MODEL=                   # Bắt buộc nếu ép xai/openai model cụ thể.
# SABLE_EMBED_HASH_DIM=512             # Mặc định 512.
# SABLE_VECTOR_MAX_CHUNKS=20000        # Mặc định 20000.
# SABLE_VECTOR_CHUNK_CHARS=800         # Mặc định 800.
# SABLE_VECTOR_SYNC_MIN=10             # Phút. Mặc định 10.
# SABLE_RECALL_TOKENS=500              # Budget token context recall. Mặc định 500.
# SABLE_TRACE_RETAIN_DAYS=14           # ≥7. Mặc định 14.
# SABLE_TOOLINDEX_OS=                  # debian|macos gợi ý package. Tùy chọn.
# SABLE_SHARE_BASE=                    # Origin link /s/; mặc định TRUSTED đầu.

# =============================================================================
# Chỉ test / nội bộ — không cần trên VPS production
# =============================================================================
# SABLE_FAKE_SECRET_FOR_TEST=          # Fixture test. Không dùng production.
# BROWSER_ALLOW_EXTERNAL_HOST=         # Smoke browser script.
# BROWSER_SMOKE_TIMEOUT_MS=45000
# BROWSER_SMOKE_BASELINE=
# PREVIEW_READY_TIMEOUT_MS=60000
# PREVIEW_THUMBNAIL_TIMEOUT_MS=45000
# CHAT_RATE_LIMIT=0                    # Legacy rate chat (nếu còn đọc).
# CHAT_RATE_WINDOW_MIN=
